# ---------------------------------------------------------------------------
# نمونه متغیرهای محیطی — این فایل کامیت می‌شود و مقدار واقعی داخلش نیست.
#
# برای راه‌اندازی پروژه: این فایل را به .env.local کپی کن و مقادیر را پر کن.
#   Windows:  copy .env.example .env.local
#   mac/linux: cp .env.example .env.local
# ---------------------------------------------------------------------------

# connection string دیتابیس Postgres (روی Liara ساخته می‌شود).
# فرمت: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# اگر اتصال از بیرون است و گواهی SSL خطا داد: ?sslmode=require را اضافه کن.
DATABASE_URL=

# اختیاری — حداکثر کانکشن همزمان pool. خالی بگذار تا پیش‌فرض ۱۰ استفاده شود.
DATABASE_POOL_MAX=
