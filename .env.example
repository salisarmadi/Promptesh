# ---------------------------------------------------------------------------
# نمونه متغیرهای محیطی — این فایل کامیت می‌شود و مقدار واقعی داخلش نیست.
#
# برای راه‌اندازی پروژه: این فایل را به .env.local کپی کن و مقادیر را پر کن.
#   Windows:  copy .env.example .env.local
#   mac/linux: cp .env.example .env.local
#
# ⚠️ هیچ‌کدام از متغیرهای این فایل پیشوند NEXT_PUBLIC_ ندارند، و نباید داشته
#    باشند. آن پیشوند مقدار را داخل جاوااسکریپتِ مرورگر می‌گذارد — یعنی رشته‌ی
#    اتصالِ دیتابیس و کلیدهای خصوصی برای هر بازدیدکننده‌ای قابلِ خواندن می‌شد.
#    تنها استثنا NEXT_PUBLIC_SITE_URL است که پایینِ همین فایل توضیح داده شده.
# ---------------------------------------------------------------------------

# ── دیتابیس ────────────────────────────────────────────────────────────────

# connection string دیتابیس Postgres (روی Supabase ساخته می‌شود).
# فرمت: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# اگر اتصال از بیرون است و گواهی SSL خطا داد: ?sslmode=require را اضافه کن.
DATABASE_URL=

# اختیاری — حداکثر کانکشن همزمان pool. خالی بگذار تا پیش‌فرض ۱۰ استفاده شود.
DATABASE_POOL_MAX=

# اختیاری — حداکثر زمان انتظار برای اتصال دیتابیس، به میلی‌ثانیه.
DATABASE_CONNECTION_TIMEOUT_MS=2000

# برای توسعه‌ی رابط بدون اتصال دیتابیس، 1 بگذار تا صفحه‌ها فوری پیام اتصال بدهند.
DATABASE_OFFLINE=

# ── پنل مدیریت (/admin) ────────────────────────────────────────────────────
#
# هر دو مقدار زیر با یک دستور ساخته می‌شوند:
#     node scripts/hash-password.mjs
#
# اسکریپت رمز را می‌پرسد (بدون نمایش روی صفحه) و دو خطِ آماده چاپ می‌کند تا
# اینجا کپی کنی. رمزِ خام هیچ‌جا ذخیره نمی‌شود — نه در فایل، نه در دیتابیس.

# هشِ scrypt رمزِ مدیر. با «scrypt$» شروع می‌شود.
# ⚠️ رمزِ خام را اینجا نگذار؛ برنامه قبولش نمی‌کند و خطای واضح می‌دهد.
ADMIN_PASSWORD_HASH=

# کلیدِ امضای کوکیِ نشست (HMAC-SHA256). حداقل ۳۲ کاراکتر.
# عوض‌کردنش همه‌ی نشست‌های باز را باطل می‌کند — راهِ «خروج از همه‌ی دستگاه‌ها».
ADMIN_SESSION_SECRET=

# ── استوریج تصاویر (Supabase Storage) ──────────────────────────────────────
#
# برای آپلودِ تصویر از پنل لازم است. هر دو از داشبورد Supabase می‌آیند:
#     Project Settings → API

# آدرس پروژه، مثلاً https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# کلیدِ service_role.
# ⚠️ این کلید همه‌ی قواعدِ RLS را دور می‌زند و دسترسیِ کاملِ خواندن و نوشتن
#    دارد. فقط سمتِ سرور استفاده می‌شود و هرگز نباید NEXT_PUBLIC_ بگیرد یا در
#    کامپوننتِ کلاینتی ایمپورت شود.
SUPABASE_SERVICE_ROLE_KEY=

# ── سایت ───────────────────────────────────────────────────────────────────

# آدرس کاملِ سایت در محیطِ واقعی، مثلاً https://promptesh.ir
# فقط برای ساختِ آدرس‌های مطلقِ متادیتا و canonical استفاده می‌شود، پس عمومی
# بودنش بی‌اشکال است. اگر خالی باشد، آدرس‌های OG نسبی می‌مانند (در dev بی‌مشکل).
NEXT_PUBLIC_SITE_URL=
